# ========================================
# 📌 Development Environment
# ========================================
PROJECT_NAME="Ecommerce API (Dev)"

# Database host dalam Docker adalah "db"
DATABASE_URL=postgresql://postgres:postgres@db:5432/ecommerce

# Security (development only, boleh berubah sewaktu-waktu)
ACCESS_SECRET=dev-access-secret
REFRESH_SECRET=dev-refresh-secret

# Token TTL
ACCESS_EXPIRE_MINUTES=30
REFRESH_EXPIRE_DAYS=7

# Environment flag
ENV=development

# CORS untuk Next.js dev
BACKEND_CORS_ORIGINS=http://localhost:3000
