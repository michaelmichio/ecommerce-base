# =========================================
# 📦 Backend Dockerfile.prod (Production)
# =========================================

FROM python:3.12-slim

# Disable Python buffering
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Only install required OS libs (more minimal)
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency file first for better build caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy app code
COPY app ./app

# Make sure uploads directory exists
RUN mkdir -p /app/app/storage/uploads

# Use uvicorn WITHOUT reload for production
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
