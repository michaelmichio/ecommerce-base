# ========================================
# 📌 Production Environment
# ========================================
PROJECT_NAME="Ecommerce API (Prod)"

# Tetap gunakan hostname "db" jika database berjalan via Docker Compose
DATABASE_URL=postgresql://postgres:postgres@db:5432/ecommerce

# Production secrets (HARUS DIGANTI!)
ACCESS_SECRET=change-this-access-secret
REFRESH_SECRET=change-this-refresh-secret

# Token TTL (biasanya lebih ketat di production)
ACCESS_EXPIRE_MINUTES=30
REFRESH_EXPIRE_DAYS=7

# Environment flag
ENV=production

# CORS untuk domain production
# Jika belum punya domain, sementara gunakan port frontend prod:
BACKEND_CORS_ORIGINS=http://localhost:3000
